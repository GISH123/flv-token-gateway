# Listener
GATEWAY_HOST=0.0.0.0
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18088
GATEWAY_ENABLE_HTTP=true
GATEWAY_ENABLE_HTTPS=true
GATEWAY_LOG_LEVEL=info

# Public client-visible URL
PUBLIC_BASE_URL=https://10.2.192.9:18088

# Internal/source FLV origin
UPSTREAM_BASE_URL=https://10.2.192.8:8088

# Token
TOKEN_SECRET=replace-me-with-at-least-32-random-characters
TOKEN_TTL_SECONDS=600
TOKEN_ISSUER_API_KEY=

# Upstream TLS
UPSTREAM_VERIFY_TLS=false

# Browser
CORS_ALLOW_ORIGINS=*

# Test/default stream
TEST_STREAM_PATH=/gishtest/gish.flv

# Gateway HTTPS certificate
TLS_CERT_FILE=certs/gateway.crt
TLS_KEY_FILE=certs/gateway.key