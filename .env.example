# Public address clients will receive in token responses.
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Internal/source streaming origin. For intranet deployment this can be:
# UPSTREAM_BASE_URL=https://10.2.192.8:8088
UPSTREAM_BASE_URL=http://127.0.0.1:9090

# MUST be replaced by a long random value in production.
TOKEN_SECRET=replace-me-with-at-least-32-random-characters
TOKEN_TTL_SECONDS=300

# Optional: if non-empty, POST /api/v1/tokens requires X-Token-API-Key.
TOKEN_ISSUER_API_KEY=

# Set false only when the internal upstream uses a self-signed certificate.
UPSTREAM_VERIFY_TLS=true
