# Gateway listener. 0.0.0.0 allows other LAN hosts to connect.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=18088
GATEWAY_LOG_LEVEL=info

# Public address clients receive in token responses.
# For the current intranet deployment:
# PUBLIC_BASE_URL=http://10.2.192.9:18088
PUBLIC_BASE_URL=http://127.0.0.1:18088

# Internal/source streaming origin. Clients do not receive this URL.
# For the current intranet deployment:
# UPSTREAM_BASE_URL=https://10.2.192.8:8088
UPSTREAM_BASE_URL=http://127.0.0.1:9090

TOKEN_SECRET=replace-me-with-at-least-32-random-characters
TOKEN_TTL_SECONDS=300
TOKEN_ISSUER_API_KEY=
UPSTREAM_VERIFY_TLS=true

# Browser player CORS. "*" is convenient for POC/demo.
# Production example: CORS_ALLOW_ORIGINS=http://10.2.192.8:8080
CORS_ALLOW_ORIGINS=*

# Initial path shown by the bundled Test UI.
TEST_STREAM_PATH=/gishtest/gish.flv
