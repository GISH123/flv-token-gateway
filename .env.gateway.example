# FLV Token Gateway configuration (.9 machine only)
# Gateway: GATEWAY_HOST
# Origin : ORIGIN_HOST

# Gateway listeners
GATEWAY_HOST=0.0.0.0
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18088
GATEWAY_LOG_LEVEL=info

# Public client-visible Gateway URL
PUBLIC_BASE_URL=https://GATEWAY_HOST:18088

# Internal Origin. This value belongs ONLY on the Gateway machine.
UPSTREAM_BASE_URL=https://ORIGIN_HOST:8088

# Token
TOKEN_SECRET=replace-me-with-at-least-32-random-characters
TOKEN_TTL_SECONDS=600
TOKEN_ISSUER_API_KEY=

# Upstream TLS
UPSTREAM_VERIFY_TLS=false

# Standalone Player runs from localhost on the client machine.
# "*" is convenient for current intranet testing.
# Tighter example:
# CORS_ALLOW_ORIGINS=http://127.0.0.1:18100,http://localhost:18100
CORS_ALLOW_ORIGINS=http://127.0.0.1:18100,http://localhost:18100

# Test/default stream
TEST_STREAM_PATH=/gishtest/gish.flv

# Gateway HTTPS certificate
TLS_CERT_FILE=certs/gateway.crt
TLS_KEY_FILE=certs/gateway.key
